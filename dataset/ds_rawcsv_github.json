{
	"name": "ds_rawcsv_github",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_http_githubparam",
			"type": "LinkedServiceReference",
			"parameters": {
				"repoOwner": "faruhbek",
				"repoName": "de_project",
				"branchName": "main"
			}
		},
		"parameters": {
			"folderPath": {
				"type": "String",
				"defaultValue": " "
			},
			"fileName": {
				"type": "String",
				"defaultValue": " "
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "HttpServerLocation",
				"relativeUrl": {
					"value": "@concat('raw/' ,dataset().fileName)",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"rowDelimiter": "\n",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}