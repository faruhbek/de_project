{
	"name": "ls_http_githubparam",
	"properties": {
		"parameters": {
			"repoOwner": {
				"type": "String",
				"defaultValue": "faruhbek"
			},
			"repoName": {
				"type": "String",
				"defaultValue": "de_project"
			},
			"branchName": {
				"type": "String",
				"defaultValue": "main"
			}
		},
		"annotations": [],
		"type": "HttpServer",
		"typeProperties": {
			"url": "@{concat(\n  'https://raw.githubusercontent.com/',\n  linkedService().repoOwner,      '/', \n  linkedService().repoName,       '/',\n  'refs/heads/', \n  linkedService().branchName,     '/'\n)}",
			"enableServerCertificateValidation": true,
			"authenticationType": "Basic",
			"userName": "faruhbek",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "kv_testing",
					"type": "LinkedServiceReference"
				},
				"secretName": "github-token"
			}
		}
	},
	"type": "Microsoft.DataFactory/factories/linkedservices"
}