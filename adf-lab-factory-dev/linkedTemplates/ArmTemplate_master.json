{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-lab-factory-dev"
		},
		"ls_azuresql_db_project_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_db_project'"
		},
		"ls_http_githubapi_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_http_githubapi'"
		},
		"kv_testing_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-detesting.vault.azure.net/"
		},
		"ls_adls_project_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://strdatabrickssadls.dfs.core.windows.net/"
		},
		"ls_azuresql_db_project_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "projectserversql.database.windows.net"
		},
		"ls_azuresql_db_project_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldbproject"
		},
		"ls_azuresql_db_project_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "serveradmin"
		},
		"ls_detest_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0625-034525-xe8la8d2"
		},
		"ls_http_githubapi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"ls_http_githubapi_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "faruhbek"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-lab-factory-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azuresql_db_project_password": {
						"value": "[parameters('ls_azuresql_db_project_password')]"
					},
					"ls_http_githubapi_password": {
						"value": "[parameters('ls_http_githubapi_password')]"
					},
					"kv_testing_properties_typeProperties_baseUrl": {
						"value": "[parameters('kv_testing_properties_typeProperties_baseUrl')]"
					},
					"ls_adls_project_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_project_properties_typeProperties_url')]"
					},
					"ls_azuresql_db_project_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresql_db_project_properties_typeProperties_server')]"
					},
					"ls_azuresql_db_project_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresql_db_project_properties_typeProperties_database')]"
					},
					"ls_azuresql_db_project_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresql_db_project_properties_typeProperties_userName')]"
					},
					"ls_detest_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_detest_databricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_http_githubapi_properties_typeProperties_url": {
						"value": "[parameters('ls_http_githubapi_properties_typeProperties_url')]"
					},
					"ls_http_githubapi_properties_typeProperties_userName": {
						"value": "[parameters('ls_http_githubapi_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}