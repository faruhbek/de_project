			"defaultValue": "AdventureWorks2022"
		},
		"ls_OnPrem_AdventureWorks_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "testuser"
		},
		"ls_http_githubparam_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{concat(\n  'https://raw.githubusercontent.com/',\n  linkedService().repoOwner,      '/', \n  linkedService().repoName,       '/',\n  'refs/heads/', \n  linkedService().branchName,     '/'\n)}"
		},
		"ls_http_githubparam_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "faruhbek"
		},
		"ls_http_nycovid_data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/nytimes/covid-19-data/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
