		"LS_ADLS_Storage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Storage'"
		},
		"LS_BlobStorage002_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BlobStorage002'"
		},
		"LS_DATA_LAKE002_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DATA_LAKE002'"
		},
		"LS_LocalFileSystem_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_LocalFileSystem'"
		},
		"ls_blob_storage_dest_connectionString": {
			"type": "secureString",
