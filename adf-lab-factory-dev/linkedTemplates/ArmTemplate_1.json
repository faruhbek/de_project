			"type": "string",
			"defaultValue": "https://strnewadlslab.dfs.core.windows.net/"
		},
		"LS_ADLS_Storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://strnewadlslab.dfs.core.windows.net/"
		},
		"LS_DATA_LAKE002_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgadflabsdev.dfs.core.windows.net/"
		},
		"LS_HTTP_SingleFile_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().URL}"
		},
		"LS_LocalFileSystem_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Data"
		},
		"LS_LocalFileSystem_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "Farrukh\\adfuser"
		},
		"ls_OnPrem_AdventureWorks_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "Farrukh\\SQLEXPRESS"
