												},
												"type": "String"
											},
											"FilePath": {
												"value": null,
												"type": "String"
											},
											"FileSHA": {
												"value": null,
												"type": "String"
											},
											"FileSizeBytes": {
												"value": null,
												"type": "Int64"
											},
											"FilesRead": {
												"value": {
													"value": "@activity('create_bronze_delta_tables').output.runOutput.rowCount",
													"type": "Expression"
												},
												"type": "Int32"
											},
											"FilesWritten": {
												"value": null,
												"type": "Int32"
											},
											"IntegrationRuntime": {
												"value": null,
												"type": "String"
