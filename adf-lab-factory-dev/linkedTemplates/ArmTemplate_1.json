												"type": "String"
											},
											"DIUsUsed": {
												"value": null,
												"type": "Int32"
											},
											"ErrorMessage": {
												"value": null,
												"type": "String"
											},
											"FileName": {
												"value": {
													"value": "@activity('create_bronze_delta_tables').output.runOutput.fileName",
