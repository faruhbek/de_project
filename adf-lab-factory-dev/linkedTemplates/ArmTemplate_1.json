						"type": "SecureString",
						"value": "[parameters('AzureDataLakeStorage2_accountKey')]"
					}
				},
				"connectVia": {
					"referenceName": "IR-CloudAuto",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": []
