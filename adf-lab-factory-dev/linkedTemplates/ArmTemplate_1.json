					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_OnPrem_AdventureWorks_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_sqldbsecret",
							"type": "LinkedServiceReference"
						},
						"secretName": "SQLdbsecret"
					}
				},
				"connectVia": {
					"referenceName": "IR-SelfHostedLocal",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": []
