{
	"name": "pl_ingestion_github_adls",
	"properties": {
		"activities": [
			{
				"name": "ListFilesInRaw",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Pipeline Rundate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/faruhbek/de_project/contents/raw?ref=main"
				}
			},
			{
				"name": "FiltertoFiles",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ListFilesInRaw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('ListFilesInRaw').output.Response)  ",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().type,'file')  ",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Pipeline Rundate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "varDate",
					"value": "@formatDateTime(utcNow(), 'ddMMyyyy')\n"
				}
			},
			{
				"name": "copyFilesFromGithubToADLS",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FiltertoFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FiltertoFiles').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy GithubFiles into ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_http_binary_files",
									"type": "DatasetReference",
									"parameters": {
										"relativeURL": {
											"value": "@split(item().download_url, 'https://raw.githubusercontent.com/')[1]",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_github_binary_adls",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@item().name",
											"type": "Expression"
										},
										"folderName": {
											"value": "@concat(split(item().name, '.')[0], '/', concat(substring(variables('varDate'), 4, 4), '/', substring(variables('varDate'), 2, 2), '/', substring(variables('varDate'), 0, 2)))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"varDate": {
				"type": "String"
			},
			"testName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}