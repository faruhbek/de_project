{
	"name": "pl_ingestion_github_adls",
	"properties": {
		"activities": [
			{
				"name": "ListFilesInRaw",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Pipeline Rundate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/faruhbek/de_project/contents/raw?ref=main"
				}
			},
			{
				"name": "FiltertoFiles",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ListFilesInRaw",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('ListFilesInRaw').output.Response)  ",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().type,'file')  ",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Pipeline Rundate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "varDate",
					"value": "@formatDateTime(utcNow(), 'ddMMyyyy')\n"
				}
			},
			{
				"name": "copyFilesFromGithubToADLS",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FiltertoFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FiltertoFiles').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy GithubFiles into ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_http_binary_files",
									"type": "DatasetReference",
									"parameters": {
										"relativeURL": {
											"value": "@split(item().download_url, 'https://raw.githubusercontent.com/')[1]",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_github_binary_adls",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@item().name",
											"type": "Expression"
										},
										"folderName": {
											"value": "@concat(split(item().name, '.')[0], '/', concat(substring(variables('varDate'), 4, 4), '/', substring(variables('varDate'), 2, 2), '/', substring(variables('varDate'), 0, 2)))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "audit_success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy GithubFiles into ADLS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[InsertFileCopyAudit]",
								"storedProcedureParameters": {
									"ActivityName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"CopyDurationSec": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.copyDuration",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"DataReadBytes": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.dataRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"DataWrittenBytes": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.dataWritten",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"DestinationPath": {
										"value": {
											"value": "@concat(split(item().name, '.')[0], '/',\n    substring(variables('varDate'), 4, 4), '/',\n    substring(variables('varDate'), 2, 2), '/',\n    substring(variables('varDate'), 0, 2), '/',\n    item().name\n)\n",
											"type": "Expression"
										},
										"type": "String"
									},
									"DIUsUsed": {
										"value": null,
										"type": "Int32"
									},
									"ErrorMessage": {
										"value": null,
										"type": "String"
									},
									"FileName": {
										"value": {
											"value": "@split(item().name, '.')[0]",
											"type": "Expression"
										},
										"type": "String"
									},
									"FilePath": {
										"value": {
											"value": "@item().html_url",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileSHA": {
										"value": null,
										"type": "String"
									},
									"FileSizeBytes": {
										"value": null,
										"type": "Int64"
									},
									"FilesRead": {
										"value": null,
										"type": "Int32"
									},
									"FilesWritten": {
										"value": null,
										"type": "Int32"
									},
									"IntegrationRuntime": {
										"value": null,
										"type": "String"
									},
									"PipelineRunID": {
										"value": null,
										"type": "String"
									},
									"SourceURL": {
										"value": null,
										"type": "String"
									},
									"StartTimeUTC": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.executionDetails[0].start",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"Status": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.executionDetails[0].status",
											"type": "Expression"
										},
										"type": "String"
									},
									"ThroughputMBps": {
										"value": null,
										"type": "Double"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azuresql_db_project",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "audit_fail",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy GithubFiles into ADLS",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[InsertFileCopyAudit]",
								"storedProcedureParameters": {
									"ActivityName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"CopyDurationSec": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.copyDuration",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"DataReadBytes": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.dataRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"DataWrittenBytes": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.dataWritten",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"DestinationPath": {
										"value": {
											"value": "@concat(split(item().name, '.')[0], '/',\n    substring(variables('varDate'), 4, 4), '/',\n    substring(variables('varDate'), 2, 2), '/',\n    substring(variables('varDate'), 0, 2), '/',\n    item().name\n)\n",
											"type": "Expression"
										},
										"type": "String"
									},
									"DIUsUsed": {
										"value": null,
										"type": "Int32"
									},
									"ErrorMessage": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.errors",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileName": {
										"value": {
											"value": "@split(item().name, '.')[0]",
											"type": "Expression"
										},
										"type": "String"
									},
									"FilePath": {
										"value": {
											"value": "@item().html_url",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileSHA": {
										"value": null,
										"type": "String"
									},
									"FileSizeBytes": {
										"value": null,
										"type": "Int64"
									},
									"FilesRead": {
										"value": null,
										"type": "Int32"
									},
									"FilesWritten": {
										"value": null,
										"type": "Int32"
									},
									"IntegrationRuntime": {
										"value": null,
										"type": "String"
									},
									"PipelineRunID": {
										"value": null,
										"type": "String"
									},
									"SourceURL": {
										"value": null,
										"type": "String"
									},
									"StartTimeUTC": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.executionDetails[0].start",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"Status": {
										"value": {
											"value": "@activity('Copy GithubFiles into ADLS').output.executionDetails[0].status",
											"type": "Expression"
										},
										"type": "String"
									},
									"ThroughputMBps": {
										"value": null,
										"type": "Double"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azuresql_db_project",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"variables": {
			"varDate": {
				"type": "String"
			},
			"testName": {
				"type": "String"
			}
		},
		"annotations": []
	}
}