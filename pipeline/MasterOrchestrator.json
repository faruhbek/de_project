{
	"name": "MasterOrchestrator",
	"properties": {
		"activities": [
			{
				"name": "ListRawFolders",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "https://api.github.com/repos/faruhbek/de_project/contents/raw?ref=main\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachFolder",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ListRawFolders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('ListRawFolders').output.Response)\n",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "ListFilesInFolder",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "https://api.github.com/repos/faruhbek/de_project/contents/raw?ref=main\n\n\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "FilterToFiles",
							"type": "Filter",
							"dependsOn": [
								{
									"activity": "ListFilesInFolder",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@json(activity('ListFilesInFolder').output.Response)\n",
									"type": "Expression"
								},
								"condition": {
									"value": "@equals(item().type,'file')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "ForEachFile_copy1",
							"type": "ForEach",
							"dependsOn": [
								{
									"activity": "FilterToFiles",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@json(activity('FilterToFiles').output.Response)\n",
									"type": "Expression"
								},
								"isSequential": false,
								"activities": [
									{
										"name": "IngestFile_copy1",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "IngestFile",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"folderPath": {
													"value": "@item().folderPath",
													"type": "Expression"
												},
												"fileName": {
													"value": "@item().fileName",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}