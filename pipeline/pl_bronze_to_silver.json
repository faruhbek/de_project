{
	"name": "pl_bronze_to_silver",
	"properties": {
		"activities": [
			{
				"name": "Check for Silver Process",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT [AuditID]\n      ,[FileName]\n      ,[FilePath]\n      ,[SourceURL]\n      ,[DestinationPath]\n      ,[FileSHA]\n      ,[FileSizeBytes]\n      ,[DataReadBytes]\n      ,[DataWrittenBytes]\n      ,[FilesRead]\n      ,[FilesWritten]\n      ,[ThroughputMBps]\n      ,[CopyDurationSec]\n      ,[Status]\n      ,[ErrorMessage]\n      ,[IntegrationRuntime]\n      ,[DIUsUsed]\n      ,[PipelineRunID]\n      ,[ActivityName]\n      ,[StartTimeUTC]\n      ,[InsertedOnUTC]\n  FROM [dbo].[FileCopyAudit]\n  where ActivityName = 'pl_create_bronze_delta_tables'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql_audit_project",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Check for Silver Process",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Check for Silver Process').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "create silver tables",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@concat('/Workspace/Repos/faruhbek', '@', 'gmail.com/de_project/databricks/nb_create_silver_', item().FileName, '_delta_tables')",
									"type": "Expression"
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_detest_databricks",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "audit_success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "create silver tables",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[InsertFileCopyAudit]",
								"storedProcedureParameters": {
									"ActivityName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"CopyDurationSec": {
										"value": null,
										"type": "Int32"
									},
									"DataReadBytes": {
										"value": null,
										"type": "Int64"
									},
									"DataWrittenBytes": {
										"value": null,
										"type": "Int64"
									},
									"DestinationPath": {
										"value": {
											"value": "@activity('create silver tables').output.runOutput.destinationPath",
											"type": "Expression"
										},
										"type": "String"
									},
									"DIUsUsed": {
										"value": null,
										"type": "Int32"
									},
									"ErrorMessage": {
										"value": null,
										"type": "String"
									},
									"FileName": {
										"value": {
											"value": "@activity('create silver tables').output.runOutput.fileName",
											"type": "Expression"
										},
										"type": "String"
									},
									"FilePath": {
										"value": null,
										"type": "String"
									},
									"FileSHA": {
										"value": null,
										"type": "String"
									},
									"FileSizeBytes": {
										"value": null,
										"type": "Int64"
									},
									"FilesRead": {
										"value": {
											"value": "@activity('create silver tables').output.runOutput.rowCount",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"FilesWritten": {
										"value": null,
										"type": "Int32"
									},
									"IntegrationRuntime": {
										"value": null,
										"type": "String"
									},
									"PipelineRunID": {
										"value": null,
										"type": "String"
									},
									"SourceURL": {
										"value": null,
										"type": "String"
									},
									"StartTimeUTC": {
										"value": {
											"value": "@activity('create silver tables').output.runOutput.timestamp",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"Status": {
										"value": {
											"value": "@activity('create silver tables').output.runOutput.status",
											"type": "Expression"
										},
										"type": "String"
									},
									"ThroughputMBps": {
										"value": null,
										"type": "Double"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azuresql_db_project",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}